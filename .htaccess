# =============================================================================
# PayAccess — Apache configuration
# (Nginx users: see the README for the equivalent rules)
# =============================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: force HTTPS once your SSL certificate is active.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to hidden files (.git, .env, ...).
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# Never expose configuration files, the install lock or docs over HTTP.
# (install.php stays reachable so you can run the installer; delete it after.)
<FilesMatch "^(config(\.local|\.example)?\.php|install\.lock|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Static asset caching (versioned with ?v=..., so long lifetimes are safe).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# -----------------------------------------------------------------------------
# Nginx equivalent (paste into your server block):
#
#   location ~ /\. { deny all; }
#   location ~* ^/(config(\.local|\.example)?\.php|install\.lock)$ { deny all; }
#   location ~ ^/(lib|sql|templates|storage)/ { deny all; }
#   location ^~ /uploads/ { location ~ \.php$ { deny all; } }
#   location / { try_files $uri $uri/ /index.php?$query_string; }
# -----------------------------------------------------------------------------
